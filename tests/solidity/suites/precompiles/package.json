{
  "name": "precompiles",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "get-contracts": "mkdir -p ../../../../contracts/test-suites/precompiles/contracts/cosmos && rsync -avm --include='*/' --exclude='**/ERC20Minter_OpenZeppelinV5.sol' --exclude='**/WEVMOS.sol' --exclude='**/ERC20NoMetadata.sol' --include='*.sol' --exclude='*' ../../../../precompiles/ ../../../../contracts/test-suites/precompiles/contracts/cosmos/",
    "clean-contracts": "rm -rf ../../../../contracts/test-suites/precompiles/contracts/cosmos/*",
    "test-ganache": "node ../../../../contracts/node_modules/hardhat/dist/src/cli.js --config ../../../../contracts/solidity-suites/precompiles.config.mjs test",
    "test-cosmos": "yarn get-contracts && node ../../../../contracts/node_modules/hardhat/dist/src/cli.js --config ../../../../contracts/solidity-suites/precompiles.config.mjs test --network cosmos && yarn clean-contracts"
  },
  "testDirectory": "../../../../contracts/test-suites/precompiles/test"
}
